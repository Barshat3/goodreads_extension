{
  "manifest_version": 3,
  "name": "Goodreads Book Lookup",
  "version": "1.0.0",
  "description": "Highlight any book title and press Ctrl+B to instantly see its Goodreads rating in a beautiful popup.",

  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],

  "host_permissions": [
    "*://google.serper.dev/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },

  "commands": {
    "lookup_book": {
      "suggested_key": {
        "default": "Ctrl+B",
        "mac": "Command+B"
      },
      "description": "Look up the selected book title on Goodreads"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_title": "Goodreads Book Lookup",
    "default_popup": "popup.html"
  }
}
